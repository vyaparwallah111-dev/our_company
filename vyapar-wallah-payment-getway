<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Vyapar Wallah | Secure Payment Gateway</title>
    
    <link rel="icon" type="image/png" sizes="192x192" href="favicon.png">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <style>
        :root {
            --primary-blue: #0A4C95;
            --accent-orange: #F37021;
            --bg-light: #f4f7fb;
            --text-dark: #2c3e50;
            --border-color: #e1e8f0;
            --success-green: #0cbd4c;
            --danger-red: #e74c3c;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Poppins', sans-serif; }
        
        /* Prevent selection to avoid unwanted copying */
        body { background-color: var(--bg-light); color: var(--text-dark); min-height: 100vh; user-select: none; }

        /* =========================================
           🚀 LAYOUT: SPLIT SCREEN (LEFT FIXED, RIGHT SCROLL)
           ========================================= */
        .pg-wrapper {
            display: flex;
            min-height: 100vh;
            max-width: 1400px;
            margin: 0 auto;
            background: var(--bg-light);
            box-shadow: 0 0 50px rgba(0,0,0,0.05);
            align-items: flex-start; /* Ensures they start at top */
        }

        /* --- 🚀 LEFT SIDE: FIXED (STICKY) INFO --- */
        .pg-info-side {
            flex: 1.1;
            background: linear-gradient(135deg, var(--primary-blue), #052c5c);
            color: white;
            padding: 60px 5%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: sticky; /* Makes it stay in place */
            top: 0;
            height: 100vh;
            overflow: hidden;
        }
        /* Background Graphic/Pattern */
        .pg-info-side::after {
            content: ''; position: absolute; right: -100px; bottom: -100px; width: 400px; height: 400px; border-radius: 50%; background: rgba(255,255,255,0.05); pointer-events: none;
        }
        
        .info-title { font-size: 2.5rem; font-weight: 800; margin-bottom: 15px; line-height: 1.2; position: relative; z-index: 2;}
        .info-title span { color: var(--accent-orange); }
        .info-desc { font-size: 1.1rem; color: #c9dff1; margin-bottom: 40px; position: relative; z-index: 2;}

        .steps-container { display: flex; flex-direction: column; gap: 25px; position: relative; z-index: 2; margin-bottom: 40px;}
        .step-item { display: flex; align-items: flex-start; gap: 15px; animation: slideIn 0.8s ease forwards; opacity: 0; transform: translateX(-30px); }
        .step-item:nth-child(1) { animation-delay: 0.2s; }
        .step-item:nth-child(2) { animation-delay: 0.4s; }
        .step-item:nth-child(3) { animation-delay: 0.6s; }
        
        .step-icon { width: 50px; height: 50px; background: rgba(255,255,255,0.1); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; color: var(--accent-orange); flex-shrink: 0; backdrop-filter: blur(5px); border: 1px solid rgba(255,255,255,0.2); }
        .step-text h4 { font-size: 1.15rem; margin-bottom: 5px; font-weight: 600; }
        .step-text p { font-size: 0.9rem; color: #b0cbe8; line-height: 1.5; }

        @keyframes slideIn { to { opacity: 1; transform: translateX(0); } }

        /* --- 🚀 RIGHT SIDE: SCROLLABLE PAYMENT PORTAL --- */
        .pg-pay-side {
            flex: 0.9;
            padding: 50px 5%;
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            align-items: center;
            background: var(--bg-light);
            min-height: 100vh;
        }

        .payment-box {
            width: 100%;
            max-width: 440px;
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.06);
            border: 1px solid var(--border-color);
            padding: 40px 30px;
            margin-bottom: 20px; /* Space before support section */
        }

        /* LOGO & BRANDING HERE */
        .brand-logo-wrapper { text-align: center; margin-bottom: 25px; border-bottom: 2px solid var(--bg-light); padding-bottom: 20px;}
        .brand-logo-wrapper img { max-height: 55px; margin-bottom: 10px; }
        .brand-logo-wrapper h2 { font-size: 1.8rem; color: var(--primary-blue); font-weight: 800; line-height: 1;}
        .brand-logo-wrapper h2 span { color: var(--accent-orange); }

        /* Form Elements */
        .form-group { margin-bottom: 18px; position: relative;}
        .form-group label { display: block; font-size: 0.9rem; font-weight: 600; margin-bottom: 8px; color: #555; }
        .form-control { width: 100%; padding: 12px 15px; border: 1px solid var(--border-color); border-radius: 8px; font-size: 1rem; transition: 0.3s; outline: none; background: #fafafa; font-family: 'Poppins', sans-serif;}
        .form-control:focus { border-color: var(--primary-blue); box-shadow: 0 0 0 3px rgba(10, 76, 149, 0.1); background: white;}
        select.form-control { cursor: pointer; appearance: none; }
        .select-icon { position: absolute; right: 15px; top: 42px; color: #888; pointer-events: none;}
        
        .amount-wrapper { position: relative; }
        .amount-wrapper i { position: absolute; left: 15px; top: 50%; transform: translateY(-50%); color: #555; font-size: 1.1rem; }
        .amount-wrapper input { padding-left: 35px; font-weight: 700; color: var(--primary-blue); font-size: 1.2rem;}

        /* Coupon Section */
        .coupon-box { background: #fdfdfd; border: 1px dashed #ccc; padding: 15px; border-radius: 8px; margin-bottom: 20px; }
        .coupon-input-group { display: flex; gap: 10px; }
        .coupon-input-group input { flex: 1; padding: 10px; border: 1px solid #ddd; border-radius: 5px; text-transform: uppercase; font-weight: 600; outline: none;}
        .coupon-input-group button { background: var(--text-dark); color: white; border: none; padding: 0 15px; border-radius: 5px; cursor: pointer; font-weight: 600; transition: 0.3s;}
        .coupon-input-group button:hover { background: var(--primary-blue); }
        .coupon-input-group button:disabled { background: #ccc; cursor: not-allowed; }
        .coupon-msg { font-size: 0.85rem; margin-top: 8px; font-weight: 600; display: none; }
        .msg-success { color: var(--success-green); }
        .msg-error { color: var(--danger-red); }
        
        .final-amount-box { display: flex; justify-content: space-between; align-items: center; background: #e8f0fe; padding: 15px; border-radius: 8px; margin-bottom: 20px; font-weight: 700; color: var(--primary-blue); display: none; border-left: 4px solid var(--accent-orange);}
        .original-price { text-decoration: line-through; color: #888; font-size: 0.9rem; margin-right: 10px; font-weight: 500;}

        /* Buttons */
        .btn-pay { width: 100%; background: var(--primary-blue); color: white; padding: 16px; border: none; border-radius: 8px; font-size: 1.1rem; font-weight: 700; cursor: pointer; transition: 0.3s; display: flex; justify-content: center; align-items: center; gap: 10px; margin-top: 10px; text-decoration: none;}
        .btn-pay:hover { background: #083c75; transform: translateY(-2px); box-shadow: 0 5px 15px rgba(10, 76, 149, 0.3); }
        .btn-wa-green { background: #25D366; }
        .btn-wa-green:hover { background: #1ebd5a; box-shadow: 0 5px 15px rgba(37, 211, 102, 0.3); }
        .btn-back { background: #f4f4f4; color: #555; }
        .btn-back:hover { background: #e0e0e0; transform: translateY(0); box-shadow: none;}

        /* Desktop & Mobile QR logic */
        .desktop-qr-section { text-align: center; border: 2px dashed var(--border-color); border-radius: 12px; padding: 20px; margin-bottom: 20px; background: #fafafa;}
        .desktop-qr-section img { width: 220px; height: 220px; margin: 0 auto; display: block; border-radius: 10px; mix-blend-mode: multiply;}
        .upi-id { font-size: 1rem; font-weight: 700; color: var(--primary-blue); background: #e8f0fe; padding: 8px 15px; border-radius: 5px; display: inline-block; margin-top: 10px; letter-spacing: 0.5px; }
        
        .mobile-intent-section { display: none; margin-bottom: 25px; }
        .btn-upi-app { background: white; border: 2px solid var(--primary-blue); color: var(--primary-blue); width: 100%; padding: 15px; border-radius: 8px; font-size: 1.1rem; font-weight: 700; text-align: center; text-decoration: none; display: flex; justify-content: center; align-items: center; gap: 10px; transition: 0.3s; }
        .btn-upi-app i { color: var(--success-green); font-size: 1.3rem;}

        /* Steps */
        .pay-step { display: none; }
        .pay-step.active { display: block; animation: fadeIn 0.4s ease; }
        
        /* Receipt */
        .receipt-box { background: #fff; border: 1px solid #eee; padding: 20px; border-radius: 10px; margin-bottom: 20px; text-align: left; box-shadow: 0 4px 10px rgba(0,0,0,0.02);}
        .receipt-row { display: flex; justify-content: space-between; border-bottom: 1px dashed #ddd; padding: 10px 0; font-size: 0.95rem; }
        .receipt-row:last-child { border-bottom: none; }
        .receipt-row strong { color: var(--text-dark); text-align: right; }
        .success-icon { font-size: 4.5rem; color: var(--success-green); text-align: center; margin-bottom: 15px; animation: popIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275); }

        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes popIn { 0% { transform: scale(0); } 100% { transform: scale(1); } }

        /* =========================================
           🚀 RIGHT SIDE FOOTER: SUPPORT & LEGAL
           ========================================= */
        .right-footer-wrapper {
            width: 100%;
            max-width: 440px;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .help-center-box {
            background: white; border: 1px solid var(--border-color); border-radius: 12px; padding: 20px; text-align: center; font-size: 0.9rem; color: #555; box-shadow: 0 4px 15px rgba(0,0,0,0.02);
        }
        .help-center-box strong { color: var(--primary-blue); display: block; margin-bottom: 5px; font-size: 1.05rem;}
        .btn-help-wa { display: inline-flex; align-items: center; justify-content: center; gap: 8px; background: #25D366; color: white; padding: 10px 20px; border-radius: 50px; text-decoration: none; font-weight: 600; margin-top: 12px; transition: 0.3s; width: 100%;}
        .btn-help-wa:hover { background: #1ebd5a; }

        .secure-badge { display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 0.9rem; color: var(--success-green); font-weight: 600; margin-top: 10px; }
        
        .legal-links { text-align: center; font-size: 0.8rem; color: #777; border-top: 1px solid #dcdcdc; padding-top: 15px; line-height: 1.8;}
        .legal-links a { color: var(--primary-blue); text-decoration: none; font-weight: 500; margin: 0 5px;}
        .legal-links a:hover { text-decoration: underline; color: var(--accent-orange); }

        /* 📱 RESPONSIVE */
        @media(max-width: 992px) {
            .pg-wrapper { flex-direction: column; }
            /* Turn off sticky for mobile */
            .pg-info-side { padding: 40px 5%; text-align: center; position: static; height: auto; }
            .step-item { flex-direction: column; align-items: center; text-align: center; }
            
            .pg-pay-side { padding: 40px 20px; }
            .payment-box, .right-footer-wrapper { max-width: 100%;}
            
            .desktop-qr-section { display: none; }
            .mobile-intent-section { display: block; }
        }
    </style>
</head>

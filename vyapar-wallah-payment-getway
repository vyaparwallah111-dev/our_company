    <script>
        // 🚀 SECURITY: Prevent F12, Ctrl+U, Ctrl+Shift+I
        document.addEventListener('keydown', function(event) {
            if (event.keyCode == 123 || (event.ctrlKey && event.shiftKey && event.keyCode == 73) || (event.ctrlKey && event.keyCode == 85)) {
                event.preventDefault();
                return false;
            }
        });

        // ⚠️ 1. YOUR UPI DETAILS
        const YOUR_UPI_ID = "avinashkumarjha8808@ybl"; 
        const YOUR_BUSINESS_NAME = "Vyapar Wallah";
        const YOUR_WHATSAPP = "9187641492";

        let finalAmountToPay = 0; 
        let discountApplied = 0;
        let isCouponUsed = false; 

        const step1 = document.getElementById('step-1');
        const step2 = document.getElementById('step-2');
        const step3 = document.getElementById('step-3');

        function checkOtherService(selectElement) {
            let otherDiv = document.getElementById('other_service_div');
            let otherInput = document.getElementById('c_other_service');
            if(selectElement.value === "Other") {
                otherDiv.style.display = "block";
                otherInput.setAttribute("required", "true");
            } else {
                otherDiv.style.display = "none";
                otherInput.removeAttribute("required");
                otherInput.value = "";
            }
        }

        // 🚀 ENCRYPTED MAGIC LINKS LOGIC (Decodes and Locks Fields)
        window.onload = function() {
            const urlParams = new URLSearchParams(window.location.search);
            // अब हम amount या service नहीं, सीधा 'pay_id' ढूँढेंगे
            const token = urlParams.get('pay_id');

            if(token) {
                try {
                    // 1. सीक्रेट टोकन को डिकोड करना (Base64 to JSON)
                    let decodedData = JSON.parse(decodeURIComponent(atob(token)));
                    let preAmount = decodedData.a;
                    let preService = decodedData.s;

                    let amtInput = document.getElementById('c_amount');
                    let srvSelect = document.getElementById('c_service');
                    let customSrvDiv = document.getElementById('other_service_div');
                    let customSrvInput = document.getElementById('c_other_service');

                    // 2. अमाउंट सेट करें और उसे LOCK कर दें 🔒
                    amtInput.value = preAmount;
                    amtInput.readOnly = true;
                    amtInput.style.backgroundColor = "#eef2f5";
                    amtInput.style.cursor = "not-allowed";

                    // 3. सर्विस सेट करें और उसे LOCK कर दें 🔒
                    let exists = false;
                    for(let i = 0; i < srvSelect.options.length; i++) {
                        if(srvSelect.options[i].value === preService) {
                            srvSelect.selectedIndex = i;
                            exists = true; 
                            break;
                        }
                    }
                    
                    // अगर सर्विस लिस्ट में नहीं है (Custom Service है)
                    if(!exists) {
                        srvSelect.value = "Other";
                        customSrvDiv.style.display = "block";
                        customSrvInput.value = preService;
                        customSrvInput.readOnly = true;
                        customSrvInput.style.backgroundColor = "#eef2f5";
                        customSrvInput.style.cursor = "not-allowed";
                    }
                    
                    // ड्रॉपडाउन को क्लिक होने से रोकें
                    srvSelect.style.pointerEvents = "none";
                    srvSelect.style.backgroundColor = "#eef2f5";

                    // 4. "Securely Locked" वाला मैसेज दिखाएं
                    document.getElementById('secure_lock_msg').style.display = "block";

                } catch(e) {
                    console.error("Invalid Payment Link");
                    // अगर किसी ने URL से छेड़छाड़ की, तो पेज नॉर्मल खुलेगा
                }
            }
        };

        // 🚀 SMART COUPON VALIDATION (Checks Phone Number)
        function applyCoupon() {
            if(isCouponUsed) return; 

            let phoneInput = document.getElementById('c_phone').value.trim();
            let amountInput = document.getElementById('c_amount').value;
            let code = document.getElementById('promo_code').value.trim().toUpperCase();
            let msgBox = document.getElementById('coupon_msg');
            let btnApply = document.getElementById('btn_apply_coupon');
            
            // Check Phone First
            if(!phoneInput || phoneInput.length < 10) {
                msgBox.innerText = "Please enter a valid 10-digit WhatsApp Number first.";
                msgBox.className = "coupon-msg msg-error";
                msgBox.style.display = "block";
                return;
            }

            // Check LocalStorage for Duplicate Use
            let usedNumbers = JSON.parse(localStorage.getItem('vyapar_used_coupons')) || [];
            if(usedNumbers.includes(phoneInput)) {
                msgBox.innerHTML = `❌ <strong>Limit Exceeded:</strong> Offer already claimed on this mobile number.`;
                msgBox.className = "coupon-msg msg-error";
                msgBox.style.display = "block";
                return;
            }

            if(!amountInput || amountInput <= 0) {
                msgBox.innerText = "Please enter Payment Amount first.";
                msgBox.className = "coupon-msg msg-error";
                msgBox.style.display = "block";
                return;
            }

            let baseAmount = parseFloat(amountInput);

            if(code === "WEL26" || code === "VWMT26") {
                let percentage = (code === "WEL26") ? 0.12 : 0.10;
                discountApplied = baseAmount * percentage; 
                finalAmountToPay = baseAmount - discountApplied;
                
                msgBox.innerHTML = `🎉 Code Applied! Saved <strong>₹${discountApplied.toFixed(0)}</strong>`;
                msgBox.className = "coupon-msg msg-success";
                
                showFinalAmountBox(baseAmount, finalAmountToPay);
                
                isCouponUsed = true;
                document.getElementById('c_amount').readOnly = true; 
                document.getElementById('promo_code').readOnly = true;
                document.getElementById('c_phone').readOnly = true; 
                btnApply.innerText = "Applied";
                btnApply.style.background = "#28a745";
                btnApply.disabled = true;

            } else {
                msgBox.innerText = "❌ Invalid Promo Code.";
                msgBox.className = "coupon-msg msg-error";
            }
            msgBox.style.display = "block";
        }

        function showFinalAmountBox(base, final) {
            document.getElementById('disp_original_price').innerText = "₹" + base.toFixed(2);
            document.getElementById('disp_final_price').innerText = final.toFixed(2);
            document.getElementById('final_amount_box').style.display = "flex";
        }

        document.getElementById('paymentForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            let baseAmount = parseFloat(document.getElementById('c_amount').value);
            let phoneInput = document.getElementById('c_phone').value.trim();

            let finalService = document.getElementById('c_service').value;
            if(finalService === "Other") {
                finalService = document.getElementById('c_other_service').value;
            }

            if(!isCouponUsed) { finalAmountToPay = baseAmount; }
            else {
                let usedNumbers = JSON.parse(localStorage.getItem('vyapar_used_coupons')) || [];
                if(!usedNumbers.includes(phoneInput)) {
                    usedNumbers.push(phoneInput);
                    localStorage.setItem('vyapar_used_coupons', JSON.stringify(usedNumbers));
                }
            }
            
            let payableAmount = finalAmountToPay.toFixed(2);
            document.getElementById('paymentForm').dataset.finalService = finalService;

            document.getElementById('show_amount').innerText = payableAmount;
            document.getElementById('show_upi_id').innerText = YOUR_UPI_ID;

            let upiString = `upi://pay?pa=${YOUR_UPI_ID}&pn=${encodeURIComponent(YOUR_BUSINESS_NAME)}&am=${payableAmount}&cu=INR`;
            
            document.getElementById('qr_image').src = `https://quickchart.io/qr?size=250&margin=1&text=${encodeURIComponent(upiString)}`;
            document.getElementById('mobile_upi_link').href = upiString;

            step1.classList.remove('active');
            step2.classList.add('active');
            window.scrollTo(0,0); // Scroll to top
        });

        function goBack() {
            step2.classList.remove('active');
            step1.classList.add('active');
            window.scrollTo(0,0);
        }

        function confirmPaymentWhatsApp() {
            let name = document.getElementById('c_name').value;
            let service = document.getElementById('paymentForm').dataset.finalService;
            let amountPaid = finalAmountToPay.toFixed(2);
            let date = new Date().toLocaleDateString('en-IN');

            document.getElementById('r_date').innerText = date;
            document.getElementById('r_name').innerText = name;
            document.getElementById('r_service').innerText = service;
            document.getElementById('r_amount').innerText = '₹' + amountPaid;

            confetti({ particleCount: 150, spread: 70, origin: { y: 0.6 }, colors: ['#0A4C95', '#F37021', '#28a745'] });

            let waMsg = `Hi Vyapar Wallah,\n\nI have initiated a payment of *₹${amountPaid}* for *${service}*.\n\nHere is my payment screenshot: [Please Attach Image]`;
            
            step2.classList.remove('active');
            step3.classList.add('active');
            window.scrollTo(0,0);

            setTimeout(() => {
                window.open(`https://wa.me/${YOUR_WHATSAPP}?text=${encodeURIComponent(waMsg)}`, '_blank');
            }, 1500); 
        }

        function sendScreenshotReminder() {
            let waMsg = `Here is my payment screenshot for verification.`;
            window.open(`https://wa.me/${YOUR_WHATSAPP}?text=${encodeURIComponent(waMsg)}`, '_blank');
        }
    </script>
</body>
